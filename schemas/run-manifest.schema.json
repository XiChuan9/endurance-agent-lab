{
  "$defs": {
    "RunConfigRecord": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "workers": {
          "minimum": 1,
          "title": "Workers",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "benchmark_path": {
          "title": "Benchmark Path",
          "type": "string"
        },
        "skill_path": {
          "title": "Skill Path",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "workers",
        "benchmark_path",
        "skill_path"
      ],
      "title": "RunConfigRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "benchmark_hash": {
      "title": "Benchmark Hash",
      "type": "string"
    },
    "skill_name": {
      "title": "Skill Name",
      "type": "string"
    },
    "skill_hash": {
      "title": "Skill Hash",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/RunConfigRecord"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Case Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "benchmark_id",
    "benchmark_version",
    "benchmark_hash",
    "skill_name",
    "skill_hash",
    "config",
    "python_version",
    "package_version",
    "case_ids"
  ],
  "title": "RunManifest",
  "type": "object"
}
